# Public production configuration. These values are not secrets.
#
# The live price feed is a display-only rollout: turn it off by setting
# NEXT_PUBLIC_PRICES_LIVE=0 in the Vercel project (the dashboard value wins
# over this file) and rebuilding. The app then falls back to catalogue prices
# and renders the chart's empty state.
NEXT_PUBLIC_PRICES_LIVE=1
NEXT_PUBLIC_PRICES_WS_URL=wss://myntle-prices.myntle.workers.dev/ws
NEXT_PUBLIC_PRICES_HTTP_URL=https://myntle-prices.myntle.workers.dev
PRICES_HTTP_URL=https://myntle-prices.myntle.workers.dev
