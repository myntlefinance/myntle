# Copy to .env.local and fill in. Never commit the filled-in version.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs and link previews (Open Graph).
# Set this to the production origin with no trailing slash. When it is
# empty, Vercel deployments fall back to the project URL automatically.
NEXT_PUBLIC_SITE_URL=

# ── AI ──────────────────────────────────────────────────────────────────────
# cloud.near.ai dashboard. Secret.
NEAR_AI_CLOUD_API_KEY=

# ── Title generation ────────────────────────────────────────────────
# Model ids, not secrets. First hit wins: NEAR first, then the OpenRouter
# fallbacks in order. A blank fallback value skips that tier.
TITLE_MODEL_NEAR=openai/gpt-6-luna
TITLE_MODEL_FALLBACK_1=
TITLE_MODEL_FALLBACK_2=
# api.openrouter.ai. Secret. Only needed for the fallback tiers.
OPENROUTER_API_KEY=

# ── NEAR Intents (1Click) ───────────────────────────────────────────────────
# partners.near-intents.org. Secret. Server-side only, sent as
# `Authorization: Bearer <key>` on quote, status, and deposit-submit calls.
# Optional: without it, quotes cost an extra 0.25%. With it, stablecoin pairs
# cost 0.01%. Required for the signed-intent endpoints the agent uses.
ONE_CLICK_API_KEY=

# ── Wallets ────────────────────────────────────────────────────────────────
# cloud.walletconnect.com. Secret. The EVM wallet picker uses this to offer
# WalletConnect wallets alongside injected ones.
WALLET_CONNECT_PROJECT_ID=
# The same value is needed on the client, because the wallet picker runs there.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Alchemy (Portfolio & Token Balances) ────────────────────────────────────
# dashboard.alchemy.com. Secret.
# Powers multi-chain token balance queries across EVM and Solana networks.
ALCHEMY_API_KEY=

# ── RPC ─────────────────────────────────────────────────────────────────────
# Configuration, not secret. The deprecated rpc.mainnet.near.org throttles
# under load and near-mainnet.public.blastapi.io no longer resolves.
NEXT_PUBLIC_NEAR_RPC_PRIMARY=https://free.rpc.fastnear.com
NEXT_PUBLIC_NEAR_RPC_BACKUP=https://rpc.fastnear.com
NEXT_PUBLIC_ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
# Solana mainnet RPC for building deposit transactions.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# ── Development wallet ──────────────────────────────────────────────────────
# A private key that lets a local session connect, sign in and send as a real
# wallet, with no extension installed. Server-side only: the browser fetches it
# from /api/dev/wallet, which 404s in a production build, so the key is never
# inlined into a bundle. Only ever use a throwaway account funded with what you
# are willing to lose. Without it there is no dev wallet at all.
DEV_WALLET_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Server only. The service role key must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Approvals ──────────────────────────────────────────────────────────────
# At least 32 bytes of high entropy. Secret.
# The server signs each approval request with this, so a modified client
# cannot fabricate one. Changing it invalidates approvals that are pending.
# Must be non-empty: an empty value kills the stream the moment a trade is
# proposed (WebCrypto refuses zero-length HMAC keys). Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
TOOL_APPROVAL_SECRET=

# ── News (public sources, read-only) ────────────────────────────────────────
# Server only. Secrets. All tools run server-side and never reach the browser.
# fetcher.sh prepaid key: top up once at https://fetcher.sh/topup, then reuse
# the returned bby_live_... key for Google News + Reddit lookups.
# Google News search costs $0.005, Reddit search $0.002 per call in USDC.
FETCHER_API_KEY=
# twitterapi.io key for X lookups (get_x_posts). Server only.
TWITTERAPI_IO_API_KEY=
# TinyFish key: create at https://agent.tinyfish.ai/api-keys. Used only for
# get_page_content (POST https://api.fetch.tinyfish.ai, markdown out).
# Free to 1,000 URLs/day, then wallet billing.
TINYFISH_API_KEY=

# ── Passkeys ───────────────────────────────────────────────────────────────
# Server flag is authoritative. When PASSKEY_ENABLED is not "true", the
# passkey routes answer 404 and no passkey code runs. The public twin only
# hides or shows the entry in the interface.
PASSKEY_ENABLED=false
NEXT_PUBLIC_PASSKEY_ENABLED=false
# WebAuthn relying party. Production requires explicit values; development
# and test default to localhost / Myntle / http://localhost:3000. RP_ID is a
# bare hostname, never a URL and never derived from the Host header.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Myntle
# Comma-separated origin allowlist, for example:
# WEBAUTHN_ORIGIN=https://myntle.xyz,https://www.myntle.xyz
WEBAUTHN_ORIGIN=http://localhost:3000
# Avoids the cbor-x native binding problem under bundling.
CBOR_NATIVE_ACCELERATION_DISABLED=true
