# Bun manages the packages. Node runs the production runtime on Vercel.

node_modules/
.next/
out/
build/
dist/

# Generated by the workflow plugin during the build.
.swc/
app/.well-known/workflow/

# TypeScript's incremental build cache.
*.tsbuildinfo

# The Bun lockfile is committed, so that installs are reproducible.
# A stray package-lock.json means something ran npm behind our back, which
# Next.js does when it cannot find a dependency it expects.
package-lock.json
yarn.lock
pnpm-lock.yaml

.env
.env.local
.env*.local

.DS_Store
*.pem
.vercel
.turbo
coverage/
/.swc

# Agent tooling. The impeccable skill is installed per agent harness, and the
# nine copies of it are 19 megabytes each. The design configuration in
# .impeccable/live/ is project configuration and is committed; the local
# consent file is not.
.agent/
.agents/
.claude/
.codex/
.cursor/
.gemini/
.hermes/
.opencode/
.pi/
.impeccable/config.local.json
